# ── Plugg — Environment Variables ──
# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/plugg

# Secret used for session cookie signing
SESSION_SECRET=your-random-secret-key-at-least-32-chars

# Local storage directory
STORAGE_DIR=.storage/uploads
STORAGE_PROVIDER=local

# R2: server-only credentials; never use VITE_ prefixes.
# Keep STORAGE_PROVIDER=local until migration and access tests are verified.
# Set STORAGE_PROVIDER=r2 only on the chosen backend after that.
R2_ACCOUNT_ID=
R2_BUCKET=plugg-private-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Hosted processing stays manual. Leave local for the current local application.
PLUGG_AUDIO_PROCESSING=local
